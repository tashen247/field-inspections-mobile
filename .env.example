# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://fim:fim@localhost:5432/fim
TEST_DATABASE_URL=postgres://fim:fim@localhost:5432/fim_test
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=fim-media
SQS_QUEUE_URL=http://localhost:4566/000000000000/fim-jobs
LOG_LEVEL=info
# Worker: log push notifications instead of sending them (no EAS project needed locally).
PUSH_DRY_RUN=true
# Base URL the Expo app uses to reach the API (use your machine's LAN IP on a physical device).
EXPO_PUBLIC_API_URL=http://localhost:3000
